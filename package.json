{
  "name": "job-search-os",
  "version": "1.0.0",
  "description": "SoloStack Job Search OS — local-first job tracker",
  "main": "electron/main.js",
  "author": "SoloStack",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder --linux AppImage --publish never",
    "electron:build:win": "npm run build && electron-builder --win portable --x64 --publish never",
    "electron:build:all": "npm run build && electron-builder --linux AppImage --win portable --x64 --publish never",
    "cap:sync": "npm run build && npx cap sync android",
    "android:build": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug"
  },
  "build": {
    "appId": "com.solostack.jobsearchos",
    "productName": "SoloStack Job Search OS",
    "directories": {
      "output": "dist/desktop"
    },
    "files": [
      "dist/web/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "public/icon.png",
        "to": "icon.png"
      }
    ],
    "linux": {
      "target": ["AppImage"],
      "category": "Office",
      "icon": "public/icon.png",
      "artifactName": "SoloStack-Job-Search-OS-${version}-linux-${arch}.${ext}"
    },
    "win": {
      "target": ["portable"],
      "icon": "public/icon.png",
      "artifactName": "SoloStack-Job-Search-OS-${version}-win-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "SoloStack-Job-Search-OS-${version}-win-portable.exe"
    }
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  }
}
